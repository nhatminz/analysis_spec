# Backward-compatible B200 config alias.
# Prefer model-specific configs under fastgrpo/configs/<model_key>/b200.env.

MODEL_KEY="${MODEL_KEY:-qwen25_7b}"

_FASTGRPO_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_FASTGRPO_DIR="$(cd "$_FASTGRPO_CONFIG_DIR/.." && pwd)"
WORKSPACE="${WORKSPACE:-$(cd "$_FASTGRPO_DIR/.." && pwd)}"

source "$_FASTGRPO_CONFIG_DIR/_shared/b200_common.env"
source "$_FASTGRPO_CONFIG_DIR/${MODEL_KEY}/b200.env"
